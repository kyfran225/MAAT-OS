# Backend Environment Variables (MAAT OS Agent Core)
PORT=8000
ENVIRONMENT=development

# LLM Providers Keys (Google Gemini, OpenAI, Anthropic & Groq LPU)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Database Configurations
POSTGRES_URL=postgresql://user:password@localhost:5432/maat_os_db
VECTOR_DB_URL=http://localhost:6333

# MAATFEED Ecosystem Security Token
MAATFEED_CORE_SECRET=super_secret_shared_token_maat_ecosystem
